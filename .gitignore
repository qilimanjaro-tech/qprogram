# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/

# Tooling caches
.cache/
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ty_cache/

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# Documentation build output
site/

# Agent tooling: the shared settings and hooks are committed, personal ones are not
.claude/*
!.claude/settings.json
!.claude/hooks/
.agents/artifacts/

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Scratch space for local experiments and notebooks
.tmp/
