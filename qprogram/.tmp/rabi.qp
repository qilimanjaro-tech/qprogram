#!QProgram 1.0

metadata:
  label: "rabi"
  description: "Rabi oscillation"

schema:
  element q:
    drive info=IQ
    readout info=IQ+acquires
    flux info=single

body:
  var gain

  average 1000:
    for gain in range(0.0, 1.0, 0.01):
      set_gain q[0].drive gain
      play q[0].drive "pi_pulse"
      sync
      measure q[0].readout "readout" "weights" "q0_m0"
